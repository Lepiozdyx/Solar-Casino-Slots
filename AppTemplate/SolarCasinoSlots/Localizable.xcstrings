    "estate.lesson.bank.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slots, blackjack, roulette and your properties share one balance. Use your starting coins and winnings to grow your casino."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tragamonedas, el blackjack, la ruleta y tus propiedades comparten el mismo saldo. Usa tus monedas iniciales y tus ganancias para ampliar el casino."
          }
        }
      }
    },
    "estate.lesson.bank.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
