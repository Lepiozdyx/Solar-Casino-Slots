          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocho giros gratis con un comodín central garantizado y premios de línea dobles."
          }
        }
      }
    },
    "rules.featureEntry %lld" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonus entry costs %lld× your stake. Spins run automatically. Pause stops after the current spin. Your remaining spins and stake are saved when you leave."
