      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combine up to 12 bets, with a maximum of 5,000 coins per bet. Tap a bet again to add a chip. You can remove individual bets or clear them all."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combina hasta 12 apuestas, con un máximo de 5.000 monedas por apuesta. Toca una apuesta de nuevo para añadir una ficha. Puedes quitar apuestas por separado o borrarlas todas."
          }
        }
      }
    },
