    "rules.blackjack.actions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playing your hand"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo jugar tu mano"
          }
        }
      }
    },
    "rules.blackjack.dealer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each hand uses a freshly shuffled 52-card deck. The dealer stands on any 17 or higher, including soft 17, and reveals the hidden card when the hand ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cada mano se barajan las 52 cartas. El crupier se planta con 17 o más, incluido el 17 suave, y revela la carta oculta al terminar la mano."
          }
        }
      }
    },
    "rules.blackjack.double" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double adds your original stake, draws exactly one card, then ends your turn. It’s available on your first two cards if you can cover the extra stake."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doblar añade el importe de la apuesta inicial, da una sola carta y termina tu turno. Solo está disponible con las dos cartas iniciales si tienes saldo para cubrir la diferencia."
          }
        }
      }
    },
    "rules.blackjack.goal" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a stake and deal. Beat the dealer without going over 21. Face cards count as 10. Aces count as 1 or 11."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la apuesta y reparte. Supera al crupier sin pasarte de 21. Las figuras valen 10. Los ases valen 1 u 11."
          }
        }
      }
    },
    "rules.blackjack.hit" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hit draws a card. Stand passes play to the dealer, as does reaching 21. Going over 21 loses immediately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedir añade una carta. Plantarse cede el turno al crupier, igual que llegar a 21. Si pasas de 21, pierdes al instante."
          }
        }
      }
    },
    "rules.blackjack.natural" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natural blackjack"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blackjack natural"
          }
        }
      }
    },
    "rules.blackjack.push" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tie"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empate"
          }
        }
      }
    },
    "rules.blackjack.settlement" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Returns include the stake. A natural is an ace and a 10-value card on the deal. Two naturals tie. Resume and finish your hand before starting another game."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El retorno incluye la apuesta. Un blackjack natural es un as y una carta de valor 10 en el reparto inicial. Dos naturales empatan. Reanuda y termina tu mano antes de empezar otro juego."
          }
        }
      }
    },
    "rules.blackjack.win" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regular win"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Victoria normal"
          }
        }
      }
    },
    "rules.cabinet.carnival" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the reels. Match from the left on 15 lines. Three festival tickets start Comet Parade. Break three rockets to reveal your free spins. Up to five rocket wilds move left and wrap each free spin. Add rocket values on a winning line to multiply its payout. New rockets add 1–3 spins, up to 40 awarded in total."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca los rodillos. Combina desde la izquierda en 15 líneas. Tres entradas del festival activan Comet Parade. Rompe tres cohetes para revelar tus giros gratis. Hasta cinco cohetes comodín avanzan a la izquierda en cada giro y vuelven por el otro lado. Suma sus valores en cada línea ganadora para multiplicar su pago. Los cohetes nuevos añaden de 1 a 3 giros, hasta 40 concedidos en total."
          }
        }
      }
    },
    "rules.cabinet.charges" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonus charges keep their values as they fall: 2×, 3×, 5×, 8×, 12×, 25× or 50×. Add the charges left on the board to multiply the spin win once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cargas del bono conservan su valor al caer: 2×, 3×, 5×, 8×, 12×, 25× o 50×. Suma las que quedan en el tablero para multiplicar una vez el premio del giro."
          }
        }
      }
    },
    "rules.cabinet.forge" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a stake and tap the reels. Three matching symbols pay on five lines. Three storm coins start Storm Lock with three respins. Each new coin resets the counter to three. MINI, MINOR and MAJOR coins pay the listed prizes. Fill all nine cells to add GRAND to your collected coins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la apuesta y toca los rodillos. Tres símbolos iguales pagan en cinco líneas. Tres monedas de tormenta activan Storm Lock con tres giros extra. Cada moneda nueva reinicia el contador a tres. Las monedas MINI, MINOR y MAJOR pagan el premio indicado. Al llenar las nueve casillas, GRAND se suma a las monedas acumuladas."
          }
        }
      }
    },
    "rules.cabinet.nougat" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the reels. Eight or more matching sweets anywhere on the 6 × 5 board pay and drop away, up to 12 tumbles. Four sugar portals award 10 free spins in Sugar Trail. During the bonus, three portals add three spins, up to 40 awarded in total."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca los rodillos. Ocho o más dulces iguales en cualquier parte del tablero de 6 × 5 pagan y desaparecen, hasta 12 cascadas. Cuatro portales de azúcar dan 10 giros gratis en Sugar Trail. En el bono, tres portales añaden tres giros, hasta 40 concedidos en total."
          }
        }
      }
    },
    "rules.cabinet.payouts.comet" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multipliers apply to the stake for 8–9 matches. Pay doubles for 10–11 and quadruples for 12 or more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los multiplicadores se aplican a la apuesta con 8–9 símbolos iguales. El pago se duplica con 10–11 y se cuadruplica con 12 o más."
          }
        }
      }
    },
    "rules.cabinet.payouts.lines" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coins per line for three matches at a stake of 100."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monedas por línea con tres símbolos iguales y una apuesta de 100."
          }
        }
      }
    },
    "rules.cabinet.payouts.longerLines" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Four matches pay 3× the line amount. Five pay 7×."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con cuatro símbolos iguales, el pago de la línea se multiplica por 3. Con cinco, por 7."
          }
        }
      }
    },
    "rules.cabinet.temple" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the reels. Match from the left on 15 lines. The golden serpent is wild. Three temple gates start Serpent Rise with eight automatic free spins. A random reel turns wild after each free spin stops. Three gates add four spins, up to 40 awarded in total."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca los rodillos. Combina desde la izquierda en 15 líneas. La serpiente dorada es comodín. Tres puertas del templo activan Serpent Rise con ocho giros gratis automáticos. Al parar los rodillos en cada giro gratis, uno al azar se vuelve comodín. Tres puertas añaden cuatro giros, hasta 40 concedidos en total."
          }
        }
      }
    },
    "rules.clusterPayment" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multiply each cluster factor by your stake and cascade multiplier. Round down to whole coins, at least one per winning group."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multiplica el factor de cada grupo por la apuesta y el multiplicador de cascada. Se redondea hacia abajo, con al menos una moneda por grupo ganador."
          }
        }
      }
    },
