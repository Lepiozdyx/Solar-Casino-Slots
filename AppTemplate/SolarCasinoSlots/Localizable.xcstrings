    "estate.lesson.income.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each property is ready 24 hours after opening or your last collection. Tap an open tile to collect its coins, or use Collect All on the board. Each property holds one payout at a time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada propiedad paga 24 horas después de abrirse o del último cobro. Toca una casilla abierta para cobrar o usa Cobrar todo en el tablero. Cada propiedad guarda un solo pago a la vez."
          }
        }
      }
    },
    "estate.lesson.income.title" : {
      "extractionState" : "manual",
      "localizations" : {
