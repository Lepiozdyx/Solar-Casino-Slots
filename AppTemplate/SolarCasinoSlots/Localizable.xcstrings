    "rules.roulette.start" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set the chip value, tap a bet to add a chip, then tap the wheel. The 37 numbers (0–36) are equally likely on every spin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el valor de la ficha, toca una apuesta para añadirla y luego toca la rueda. Los 37 números (0–36) tienen la misma probabilidad en cada giro."
          }
        }
      }
    },
    "rules.roulette.zero" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero pays only a direct bet on zero. Bets settle separately and returns include the winning stake."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cero solo paga una apuesta directa al cero. Cada apuesta se liquida por separado y el retorno incluye el importe de la apuesta ganadora."
          }
        }
      }
    },
    "rules.scatters.lines" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three rocket scatters start the bonus. Three in a free spin add three spins, up to 40 remaining."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres cohetes scatter activan el bono. Tres en un giro gratis añaden tres giros, hasta 40 pendientes."
          }
        }
      }
    },
    "rules.scatters.prism" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three rocket scatters on the opening board start the bonus. Later cascades do not count. Three in a free spin add three spins, up to 40 remaining."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres cohetes scatter en el tablero inicial activan el bono. Las cascadas siguientes no cuentan. Tres en un giro gratis añaden tres giros, hasta 40 pendientes."
          }
        }
      }
    },
    "rules.slot.orbit" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a stake and tap the reels. Match 3–5 from the left on 15 lines. Wilds replace ordinary symbols. Prize multipliers apply to the full stake."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la apuesta y toca los rodillos. Combina de 3 a 5 símbolos desde la izquierda en 15 líneas. Los comodines sustituyen símbolos normales. Los multiplicadores se aplican a la apuesta total."
          }
        }
      }
    },
    "rules.slot.prism" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the reels. Groups of 5+ matching gems that share an edge pay separately and vanish together. New gems drop in. Up to six cascades pay per spin, starting at 1× (2× in free spins) and adding 1× each time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca los rodillos. Los grupos de 5 o más gemas iguales unidas por un lado pagan por separado y desaparecen a la vez. Caen nuevas gemas. Pagan hasta seis cascadas por giro: empiezan en 1× (2× en giros gratis) y suben 1× cada vez."
          }
        }
      }
    },
    "rules.slot.redline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a stake and tap the reels. Match three from the left on five lines. Wilds replace ordinary symbols. Prize multipliers apply to the full stake."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la apuesta y toca los rodillos. Combina tres símbolos desde la izquierda en cinco líneas. Los comodines sustituyen símbolos normales. Los multiplicadores se aplican a la apuesta total."
          }
        }
      }
    },
