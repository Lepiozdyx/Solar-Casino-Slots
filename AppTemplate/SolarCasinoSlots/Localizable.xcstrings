      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seven free spins. A guaranteed wild replaces one symbol per spin, moving clockwise through the 12 outer spots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siete giros gratis. Un comodín garantizado sustituye un símbolo por giro y recorre las 12 casillas del borde en sentido horario."
          }
        }
      }
    },
