    },
    "estate.lesson.lot.body %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap ‘%@’, then tap a locked tile. The price is shown before you buy. The property and its income are revealed after purchase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca «%@» y luego una casilla cerrada. Verás el precio antes de comprar. La propiedad y sus ingresos se revelan tras la compra."
          }
        }
      }
    },
