    "empire.gameHall.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slots, blackjack and roulette use your treasury. Each result can raise or lower your shared coin balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tragamonedas, el blackjack y la ruleta usan tu tesorería. Cada resultado puede aumentar o reducir tu saldo de monedas."
          }
        }
      }
    },
    "empire.guide.box.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose any locked tile to open your first box. The property inside will add to your daily income."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cualquier casilla cerrada para abrir tu primera caja. La propiedad que contiene aumentará tus ingresos diarios."
          }
        }
      }
    },
    "empire.guide.collect.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solar Casino has your first payout ready. Collect it to afford your first mystery box."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solar Casino tiene listo tu primer pago. Cóbralo para poder comprar tu primera caja misteriosa."
          }
        }
      }
    },
    "empire.guide.hall" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ready to expand again? Visit the Game Hall to play using your treasury."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres ampliar tu imperio? Visita la Sala de juegos y juega con las monedas de tu tesorería."
          }
        }
      }
    },
    "empire.help.box.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In your Empire, open Properties and pick a locked tile. You see the price before buying. The box reveals a business that adds to your daily income."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu imperio, abre Propiedades y elige una casilla cerrada. Verás el precio antes de comprar. La caja revela un negocio que aumenta tus ingresos diarios."
          }
        }
      }
    },
    "empire.help.box.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open mystery boxes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre cajas misteriosas"
          }
        }
      }
    },
    "empire.help.hall" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From your Empire, open the Game Hall to play slots, blackjack or roulette. Stakes and payouts change the same balance you use to buy boxes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde tu imperio, abre la Sala de juegos para jugar a las tragamonedas, al blackjack o a la ruleta. Las apuestas y los premios cambian el mismo saldo que usas para comprar cajas."
          }
        }
      }
    },
    "empire.help.income" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collect ready payouts in your Empire or on the Properties board. After opening or collecting, a property takes 24 hours to produce its next payout and holds one payout at a time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cobra los pagos disponibles en tu imperio o en el tablero de Propiedades. Tras abrir una propiedad o cobrar, su próximo pago tarda 24 horas. Cada propiedad acumula un solo pago."
          }
        }
      }
    },
